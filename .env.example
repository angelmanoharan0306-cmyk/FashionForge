# ========================================================
# FashionForge — Production Environment Configuration
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (Use MongoDB Atlas URI for cloud deployment)
MONGODB_URI=

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cashfree Payment Gateway Credentials
# For production, set CASHFREE_ENV=production and provide live credentials
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01

# Public URLs (For CORS, redirection, and webhook delivery)
FRONTEND_URL=
API_BASE_URL=
