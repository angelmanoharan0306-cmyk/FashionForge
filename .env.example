# ========================================================
# FashionForge — Production & Sandbox Environment Configuration
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (Use MongoDB Atlas URI for cloud deployment)
MONGODB_URI=

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ========================================================
# Cashfree Payment Gateway Credentials
# ========================================================
# For Cashfree Sandbox Testing:
#   CASHFREE_ENV=sandbox
#   CASHFREE_APP_ID=<your_sandbox_app_id>
#   CASHFREE_SECRET_KEY=<your_sandbox_secret_key>
#   CASHFREE_WEBHOOK_SECRET=<your_sandbox_webhook_secret>
#
# For Cashfree Live Production:
#   CASHFREE_ENV=production
#   CASHFREE_APP_ID=<your_production_app_id>
#   CASHFREE_SECRET_KEY=<your_production_secret_key>
#   CASHFREE_WEBHOOK_SECRET=<your_production_webhook_secret>
#
# If credentials are left blank, FashionForge runs in Cash on Delivery mode.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01

# Public URLs (For CORS, redirection, and webhook delivery)
FRONTEND_URL=
API_BASE_URL=
