# ========================================================
# FashionForge — Production Environment Configuration
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (Use MongoDB Atlas URI for cloud deployment)
MONGODB_URI=

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ========================================================
# UPI Payment Configuration
# ========================================================
# Merchant UPI ID displayed on the payment page and encoded in the dynamic QR code:
# Format: username@bank (e.g., fashionforge@okhdfcbank or fashionforge@upi)
UPI_ID=fashionforge@upi
MERCHANT_NAME=FashionForge

# Public URLs (For CORS and client routing)
FRONTEND_URL=
API_BASE_URL=
